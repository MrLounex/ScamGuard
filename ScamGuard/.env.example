# =========================================
# ScamGuard Bot - Contoh Konfigurasi (.env)
# =========================================
# Salin file ini menjadi ".env" lalu isi nilai-nilainya.
# JANGAN commit file ".env" (berisi rahasia) ke repository publik.

# --- Telegram ---
# Dapatkan dari @BotFather di Telegram (lihat README.md bagian instalasi)
TELEGRAM_BOT_TOKEN=8629442087:AAHi3UZPZgUfI3aw-0svGHmQzOtsILkAHkM

# --- AI / LLM Provider ---
# Opsional: jika kosong, bot tetap berjalan hanya dengan rule-based detection.
AI_API_KEY=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
# Model yang digunakan (contoh: gpt-4o-mini, atau model lain sesuai provider Anda)
AI_MODEL=gpt-4o-mini
# Provider: "openai" atau "generic" (kompatibel format OpenAI Chat Completions)
AI_PROVIDER=openai
# Base URL API (ganti jika menggunakan provider lain yang kompatibel format OpenAI)
AI_BASE_URL=https://api.openai.com/v1

# --- Database ---
DATABASE_URL=sqlite:///scamguard.db

# --- Batas Upload File ---
MAX_FILE_SIZE_MB=10

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=600

# --- URL Reputation Provider (opsional) ---
# Provider: "none" (nonaktif, default) atau "generic"
URL_REPUTATION_PROVIDER=none
URL_REPUTATION_API_KEY=

# --- OCR (opsional) ---
# Isi hanya jika Tesseract tidak otomatis terdeteksi di PATH sistem Anda.
# Contoh Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# --- Logging ---
LOG_LEVEL=INFO
